# Copy to .env to override the local defaults. Environment variables take precedence.
VSF_DATA_DIR=%USERPROFILE%\Videos\VarietyShortsFactory
VSF_PORT=8765
VSF_MAX_UPLOAD_BYTES=2147483648
VSF_MAX_SOURCE_SECONDS=14400
# Optional absolute paths; PATH is not required when these are set.
VSF_FFMPEG=
VSF_FFPROBE=
